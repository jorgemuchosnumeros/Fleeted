<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net4.6</TargetFramework>
        <AssemblyName>Fleeted</AssemblyName>
        <Description>shipped but with flow</Description>
        <Version>0.1.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <ShippedManagedDir>/home/jorge/.local/share/Steam/steamapps/common/Shipped/Shipped_Data/Managed</ShippedManagedDir>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>
    

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
        <PackageReference Include="System.Memory" Version="4.5.3" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="assets\connect_icon.png" />
        <None Remove="decomp\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="assets\connect_icon.png" />
        <EmbeddedResource Include="assets\host_icon.png" />
        <EmbeddedResource Include="assets\join_icon.png" />
        <EmbeddedResource Include="assets\arrow_down_icon.png" />
        <EmbeddedResource Include="assets\arrow_left_icon.png" />
        <EmbeddedResource Include="assets\arrow_right_icon.png" />
        <EmbeddedResource Include="assets\arrow_up_icon.png" />
        <EmbeddedResource Include="assets\copy_icon.png" />
        <EmbeddedResource Include="assets\eye_icon.png" />
        <EmbeddedResource Include="assets\button_bg.png" />
        <EmbeddedResource Include="assets\dot.png" />
        <EmbeddedResource Remove="decomp\**" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ShippedManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Facepunch.Steamworks.Win64">
            <HintPath>libs\Facepunch.Steamworks.Win64.dll</HintPath>
        </Reference>
        <Reference Include="netstandard">
            <HintPath>$(ShippedManagedDir)\netstandard.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Rewired_Core">
            <HintPath>$(ShippedManagedDir)\Rewired_Core.dll</HintPath>
        </Reference>
        <Reference Include="System.Net.Http" />
        
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ShippedManagedDir)\Unity.TextMeshPro.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(ShippedManagedDir)\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AIModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.AIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.AudioModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.JSONSerializeModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ShippedManagedDir)\UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UIElementsModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.UIElementsModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(ShippedManagedDir)\UnityEngine.UIModule.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="decomp\**" />
    </ItemGroup>
</Project>
